PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# BASE_URL=https://sho.rt
SHORT_CODE_LENGTH=7
# Generate with: openssl rand -hex 32
SHORT_CODE_SECRET=change-me-to-a-random-32+-char-secret
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=86400
CACHE_MISS_TTL_SECONDS=60
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=url_shortner
PG_POOL_MAX=10
PG_SSL=false
DB_RUN_MIGRATIONS=true
